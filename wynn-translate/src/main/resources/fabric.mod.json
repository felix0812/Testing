  "entrypoints": {
    "client": ["dev.wynntranslate.WynnTranslateClient"],
    "modmenu": ["dev.wynntranslate.compat.ModMenuIntegration"]
  },
  "mixins": ["wynntranslate.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "wynntils": "*"
  }
